# Copiá este archivo a .env y completá los valores reales.
# El archivo .env no debe commitearse.

# Docker Compose
DB_PASSWORD="replace-with-a-secure-local-password"
JWT_SECRET="replace-with-a-secure-secret"

# Backend ejecutado localmente fuera de Docker
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/listafacil?schema=public"

# Opcionales: estos son los valores predeterminados del backend.
# PORT=3000
# FRONTEND_URL="http://localhost:5173"
